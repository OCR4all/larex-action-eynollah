NAME=eynollah
PORT=9000
MODEL_DIR=./models

LAREX_PROCESSOR_ID=eynollah-segmentation
LAREX_DISPATCH_HMAC_SECRET=
LAREX_ALLOWED_CALLBACK_ORIGINS=["https://larex.example.org"]
LAREX_ROUTE_PREFIXES=["/eynollah"]
LAREX_SDK_TRANSPORT_DEBUG=false

ACTION_DEBUG=false
ACTION_MAX_CONCURRENT_RUNS=1
ACTION_LOADING_TIMEOUT=300
ACTION_PROCESSING_TIMEOUT=900
ACTION_TIMEOUT_MODE=fail_page
ACTION_IDLE_TIMEOUT=600

EYNOLLAH_DEVICE=auto
EYNOLLAH_PAGE_WORKERS=
EYNOLLAH_CPU_THREADS=
EYNOLLAH_GPU_MEMORY_LIMITS=false
EYNOLLAH_MAX_IMAGE_PIXELS=300000000
